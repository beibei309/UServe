{
	"info": {
		"_postman_id": "userve-api-collection",
		"name": "UServe API Collection",
		"description": "Complete API collection for UServe services marketplace",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Health Check",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response has success status\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.status).to.eql('ok');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/health",
					"host": ["{{baseUrl}}"],
					"path": ["health"]
				}
			},
			"response": []
		},
		{
			"name": "Get All Services",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response has success field\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.success).to.eql(true);",
							"});",
							"",
							"pm.test(\"Response has data array\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.data).to.be.an('array');",
							"});",
							"",
							"pm.test(\"List payload has key attributes for app cards\", function () {",
							"    var jsonData = pm.response.json();",
							"    if (jsonData.data.length > 0) {",
							"        var first = jsonData.data[0];",
							"        pm.expect(first).to.have.property('title');",
							"        pm.expect(first).to.have.property('pricing');",
							"        pm.expect(first).to.have.property('provider');",
							"        pm.expect(first).to.have.property('image');",
							"        pm.expect(first).to.have.property('availability');",
							"    }",
							"});",
							"",
							"pm.test(\"Response has pagination info\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.pagination).to.be.an('object');",
							"});",
							"",
							"// Save first service ID for use in other requests",
							"if (pm.response.json().data.length > 0) {",
							"    pm.environment.set('serviceId', pm.response.json().data[0].id);",
							"    pm.collectionVariables.set('serviceId', pm.response.json().data[0].id);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/services?per_page=10&sort=recommended",
					"host": ["{{baseUrl}}"],
					"path": ["services"],
					"query": [
						{
							"key": "per_page",
							"value": "10"
						},
						{
							"key": "sort",
							"value": "recommended"
						}
					]
				}
			},
			"response": []
		},
		{
			"name": "Search Services",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response has correct filters\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.filters.search).to.exist;",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/services?search=app&sort=rating&per_page=5",
					"host": ["{{baseUrl}}"],
					"path": ["services"],
					"query": [
						{
							"key": "search",
							"value": "app",
							"description": "Search term"
						},
						{
							"key": "sort",
							"value": "rating",
							"description": "Sort by: recommended, newest, oldest, price_low, price_high, rating"
						},
						{
							"key": "per_page",
							"value": "5"
						}
					]
				}
			},
			"response": []
		},
		{
			"name": "Filter by Category",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response has success flag\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.success).to.eql(true);",
							"    pm.expect(jsonData.filters).to.be.an('object');",
							"});",
							"",
							"pm.test(\"Response has category filter\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.filters).to.have.property('category_id');",
							"});",
							"",
							"pm.test(\"Category filter value is passed correctly\", function () {",
							"    var jsonData = pm.response.json();",
							"    var selectedCategory = pm.variables.get('categoryId');",
							"    if (selectedCategory && String(selectedCategory).trim() !== '') {",
							"        pm.expect(String(jsonData.filters.category_id)).to.eql(String(selectedCategory));",
							"    } else {",
							"        pm.expect(jsonData.filters.category_id === null || jsonData.filters.category_id === '').to.eql(true);",
							"    }",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/services?category_id={{categoryId}}&available_only=true&sort=price_low",
					"host": ["{{baseUrl}}"],
					"path": ["services"],
					"query": [
						{
							"key": "category_id",
							"value": "{{categoryId}}",
							"description": "Filter by category ID"
						},
						{
							"key": "available_only",
							"value": "true",
							"description": "Show only available services"
						},
						{
							"key": "sort",
							"value": "price_low",
							"description": "Sort by price low to high"
						}
					]
				}
			},
			"response": []
		},
		{
			"name": "Get Service Details",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response has service data\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.success).to.eql(true);",
							"    pm.expect(jsonData.data).to.be.an('object');",
							"    pm.expect(jsonData.data.title).to.exist;",
							"    pm.expect(jsonData.data.provider).to.exist;",
							"    pm.expect(jsonData.data.pricing).to.exist;",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/services/{{serviceId}}",
					"host": ["{{baseUrl}}"],
					"path": ["services", "{{serviceId}}"]
				},
				"description": "Gets detailed information about a specific service. The serviceId variable is automatically set from the 'Get All Services' request."
			},
			"response": []
		},
		{
			"name": "Muallim Smoke Test (Index + Detail)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"var jsonData = pm.response.json();",
							"",
							"pm.test(\"Index payload has success and array data\", function () {",
							"    pm.expect(jsonData.success).to.eql(true);",
							"    pm.expect(jsonData.data).to.be.an('array');",
							"});",
							"",
							"pm.test(\"Index payload has at least 1 service\", function () {",
							"    pm.expect(jsonData.data.length).to.be.above(0);",
							"});",
							"",
							"var first = jsonData.data[0];",
							"pm.environment.set('serviceId', first.id);",
							"pm.collectionVariables.set('serviceId', first.id);",
							"",
							"pm.test(\"Index card attributes exist\", function () {",
							"    pm.expect(first).to.have.property('id');",
							"    pm.expect(first).to.have.property('title');",
							"    pm.expect(first).to.have.property('description');",
							"    pm.expect(first).to.have.property('pricing');",
							"    pm.expect(first).to.have.property('provider');",
							"    pm.expect(first).to.have.property('image');",
							"    pm.expect(first).to.have.property('category');",
							"    pm.expect(first).to.have.property('stats');",
							"    pm.expect(first).to.have.property('availability');",
							"});",
							"",
							"var base = pm.variables.get('baseUrl');",
							"var detailUrl = base + '/services/' + first.id;",
							"",
							"pm.sendRequest({",
							"    url: detailUrl,",
							"    method: 'GET',",
							"    header: { Accept: 'application/json' }",
							"}, function (err, res) {",
							"    pm.test('Detail request should not error', function () {",
							"        pm.expect(err).to.eql(null);",
							"    });",
							"",
							"    pm.test('Detail status code is 200', function () {",
							"        pm.expect(res.code).to.eql(200);",
							"    });",
							"",
							"    var detail = res.json();",
							"    pm.test('Detail payload has success and object data', function () {",
							"        pm.expect(detail.success).to.eql(true);",
							"        pm.expect(detail.data).to.be.an('object');",
							"    });",
							"",
							"    pm.test('Detail attributes for service details page exist', function () {",
							"        pm.expect(detail.data).to.have.property('title');",
							"        pm.expect(detail.data).to.have.property('description');",
							"        pm.expect(detail.data).to.have.property('pricing');",
							"        pm.expect(detail.data).to.have.property('packages');",
							"        pm.expect(detail.data).to.have.property('provider');",
							"        pm.expect(detail.data).to.have.property('availability');",
							"        pm.expect(detail.data).to.have.property('reviews');",
							"    });",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/services?per_page=5&sort=recommended",
					"host": ["{{baseUrl}}"],
					"path": ["services"],
					"query": [
						{
							"key": "per_page",
							"value": "5"
						},
						{
							"key": "sort",
							"value": "recommended"
						}
					]
				},
				"description": "Runs list checks for Muallim index page and auto-checks details endpoint attributes for the first service."
			},
			"response": []
		},
