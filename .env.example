UPSI_DB_DATABASE=myupsidb
UPSI_REFRESH_TTL_MINUTES=15
UPSI_LIVE_REFRESH_ENABLED=true
UPSI_SYNC_ENABLED=false
UPSI_SYNC_TIME=02:15
UPSI_DB_USERNAME=
UPSI_DB_PASSWORD=
UPSI_DB_SSLMODE=prefer
UPSI_STUDENT_VIEW=home2u.h2u_student

