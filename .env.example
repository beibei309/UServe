DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=upsiconnect
DB_USERNAME=root
DB_PASSWORD=

# UPSI student status source (read-only PostgreSQL)
UPSI_DB_HOST=
UPSI_DB_PORT=
