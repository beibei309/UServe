APP_NAME=UPSI2u
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=userve_db
DB_USERNAME=userve_user
DB_PASSWORD=

# UPSI student status source view
# Single-connection mode: use the same DB_CONNECTION/DB_* connection and set UPSI_DB_CONNECTION=pgsql.
# Keep live refresh disabled locally unless your DB can read UPSI_STUDENT_VIEW.
UPSI_LIVE_REFRESH_ENABLED=false
UPSI_REFRESH_TTL_MINUTES=15
UPSI_SYNC_ENABLED=false
UPSI_SYNC_TIME=02:15
UPSI_DB_CONNECTION=pgsql
UPSI_STUDENT_VIEW=home2u.h2u_student
# Optional separate-source mode:
# UPSI_DB_CONNECTION=upsi_pgsql
# UPSI_DB_HOST=
# UPSI_DB_PORT=5432
# UPSI_DB_DATABASE=
# UPSI_DB_USERNAME=
# UPSI_DB_PASSWORD=
# UPSI_DB_SCHEMA=home2u,public
# UPSI_DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
FILESYSTEM_LOCAL_SERVE=false
QUEUE_CONNECTION=database
ALLOW_DESTRUCTIVE_DATABASE_SEEDING=false

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your-email@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
